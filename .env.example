APP_ENV=local
DATABASE_URL=postgresql+psycopg://seniors:seniors_local@localhost:5432/seniors_empregabilidade
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Amazon Cognito. Copy these from the AWS console: Cognito > User pools.
# Sign-in calls an unauthenticated API, so no AWS credentials are needed here.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only when the app client was created with a secret. Never commit a real value.
COGNITO_CLIENT_SECRET=

# Local seed only (APP_ENV must be local or test). Cognito owns the password,
# so these addresses must match accounts in the user pool to sign in. Replace
# them per run, for example:
#   uv run python -m scripts.seed --candidate-email you@yourdomain.com
# candidate@example.invalid
# representative@company.example.invalid
# administrator@example.invalid
