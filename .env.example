APP_ENV=local
DATABASE_URL=postgresql+psycopg://seniors:seniors_local@localhost:5432/seniors_empregabilidade
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
BRASIL_API_BASE_URL=https://brasilapi.com.br/api
BRASIL_API_TIMEOUT_SECONDS=5
BLOCKED_CNAE_PREFIXES=[]
PERSONAL_EMAIL_DOMAINS=["gmail.com","hotmail.com","outlook.com","yahoo.com","icloud.com","bol.com.br","uol.com.br"]

# Identity operations return 503 until a pool and app client are configured.
COGNITO_REGION=us-east-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Backend only; never add this secret to frontend VITE_* variables.
COGNITO_CLIENT_SECRET=

# Certification documents. Locally they go to the s3 service in compose.yaml;
# production sets only UPLOADS_BUCKET and uses the instance role.
UPLOADS_BUCKET=seniors-uploads-local
UPLOADS_REGION=us-east-2
S3_ENDPOINT_URL=http://localhost:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# Synthetic seed users have no external identity and cannot authenticate.

# Enable only where a proxy sits in front (production, behind CloudFront).
# When enabled, the request limit keys on the last X-Forwarded-For entry;
# when disabled, on the socket address.
TRUST_PROXY_HEADERS=false
